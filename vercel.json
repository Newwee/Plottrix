{
  "version": 2,
  "framework": "vite",
  "functions": {
    "api/*.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/story/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Discordbot|TelegramBot|WhatsApp|Line|Slackbot|SkypeUriPreview|Googlebot|bingbot|crawler|spider).*"
        }
      ],
      "destination": "/api/og-preview?id=:id&type=story"
    },
    {
      "source": "/read/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Discordbot|TelegramBot|WhatsApp|Line|Slackbot|SkypeUriPreview|Googlebot|bingbot|crawler|spider).*"
        }
      ],
      "destination": "/api/og-preview?id=:id&type=read"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
